{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "generate:api": "npx --yes -p openapi-typescript@^7.13.0 openapi-typescript ../openapi.json -o src/shared/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react-dom": "^2.1.9",
    "@sentry/react": "^11.20.0",
    "@tanstack/react-query": "^5.101.1",
    "@types/animejs": "^3.1.13",
    "animejs": "^4.5.0",
    "axios": "^1.18.1",
    "framer-motion": "^12.42.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.12"
  }
}
